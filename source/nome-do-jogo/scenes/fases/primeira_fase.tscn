[sub_resource type="GDScript" id="GDScript_sm4gw"]
script/source = "extends Node2D

@export var cena_map_block: PackedScene
@export var player: CharacterBody2D

const WIDTH = 1024

var blocks: Array[Node2D] = []
var centro = 0
var boss_spawned = false

func _input(event):
	if Input.is_action_just_pressed(\"toggle_fullscreen\"):
		var current_mode = DisplayServer.window_get_mode()
		if current_mode == DisplayServer.WINDOW_MODE_WINDOWED:
			# troca pra fullscreen exclusivo
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN)
		elif current_mode == DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN:
			# volta pra windowed
			DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
			
func _ready():
	for i in range(-1, 2):
		#Spawna os blocos atras, no meio e na frente.
		spawn_block(i * WIDTH)

func spawn_block(x_pos):
	var block = cena_map_block.instantiate()
	block.position.x = x_pos
	block.position.y = 576
	$World.add_child(block)
	blocks.append(block)

func _process(_delta):
	if boss_spawned:
		return
	
	var player_block_position = int(round(player.position.x / WIDTH))
	
	if player_block_position != centro:
		shift_map(player_block_position)

func shift_map(novo_centro):
	if novo_centro > centro:
		#Foi pra direita, então adicionar esquerda na direita.
		var block_to_move = blocks.pop_front()
		block_to_move.position.x = (novo_centro + 1) * WIDTH
		# Coloca ele no fim da lista
		blocks.push_back(block_to_move)
		
	elif novo_centro < centro:
		# Foi pra esquerda, então adicionar direita na esquerda.
		var block_to_move = blocks.pop_back()
		block_to_move.position.x = (novo_centro - 1) * WIDTH
		# Coloca ele no início da lista
		blocks.push_front(block_to_move)
	
	centro = novo_centro

func spawn_boss_arena():
	boss_spawned = true
	var ultimo_block = blocks.back()
	var spawn_pos_x = ultimo_block.position.x + WIDTH
	var boss_scene = load(\"res://scenes/fases/boss_block.tscn\")
	var arena = boss_scene.instantiate()
	arena.position.x = spawn_pos_x
	arena.position.y = 576
	
	add_child(arena)
	
"

